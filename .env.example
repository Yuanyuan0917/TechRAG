# OpenAI-compatible chat-completions configuration for answer generation.
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=Qwen/Qwen3-8B-MLX-4bit

# FastAPI endpoint used by the Streamlit frontend.
TECHRAG_API_URL=http://127.0.0.1:8000

# Export before native CLI/API startup to select server mode; blank uses embedded.
QDRANT_URL=

# Compose uses this instead of the native LLM_BASE_URL above.
TECHRAG_DOCKER_LLM_BASE_URL=http://host.docker.internal:8080/v1
